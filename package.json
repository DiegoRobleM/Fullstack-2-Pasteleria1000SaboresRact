  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "^0.28.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^7.0.2",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "pngjs": "7.0.0",
    "prettier": "^3.9.10",
